#include <stdio.h>
int main()
{
    int num, i, sum = 0;
    printf("Enter a number: ");
    scanf("%d", &num);
    for(i = 1; i < num; i++)
    {
        if(num % i == 0)
        {
            sum = sum + i;
        }
    }
    if(sum == num)
        printf("%d is a Perfect Number", num);
    else
        printf("%d is not a Perfect Number", num);
    return 0;
}

OUTPUT: 

Enter a number: 6
6 is a Perfect Number

Enter a number: 10
10 is not a Perfect Number
