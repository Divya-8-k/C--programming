#include <stdio.h>
int isPrime(int n)
{
    int i;
    if (n < 2)
        return 0;
    for (i = 2; i <= n / 2; i++)
    {
        if (n % i == 0)
            return 0;
    }
    return 1;
}
int main()
{
    int n;
    printf("Enter a positive integer: ");
    scanf("%d", &n);
    if (isPrime(n))
        printf("%d is a prime number.\n", n);
    else
        printf("%d is not a prime number.\n", n);
    return 0;
}

OUTPUT:

Enter a positive integer: 17
17 is a prime number.

Enter a positive integer: 20
20 is not a prime number.
